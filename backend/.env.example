# ── Backblaze B2 ────────────────────────────────────────────────────────────────
# Endpoint varies by region, e.g. us-west-004, eu-central-003, etc.
B2_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
B2_KEY_ID=your_application_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-datadock-bucket

# Optional: set to your bucket's public/CDN base URL for instant download links
# If blank, the backend generates presigned download URLs (7-day expiry)
B2_PUBLIC_BASE_URL=https://your-bucket.s3.us-west-004.backblazeb2.com

# ── Security ─────────────────────────────────────────────────────────────────────
# Shared API key for team access — use a long random string
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change_me_to_a_strong_random_key

# ── App ──────────────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./datadock.db
MAX_FILE_SIZE_GB=10
